{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unitedrocks-backlog",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unitedrocks-backlog-db",
      "database_id": "2389b8a4-658b-4ec7-8eb2-0fcebbb95837"
    }
  ],
  // Pull request builds run `wrangler preview`, which requires this block.
  // Previews use their own database so test edits never touch real data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "unitedrocks-backlog-preview-db",
        "database_id": "6bb4678f-f772-4d24-95a4-1970cd23c20c"
      }
    ]
  }
}
