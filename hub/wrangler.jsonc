{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tribe-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  // Only reachable through hub.positivetribes.org, where Access signs people in. No workers.dev address.
  "workers_dev": false,
  "routes": [{ "pattern": "hub.positivetribes.org", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Sign-in: Cloudflare Access (One-time PIN) on this Worker's hostname. Both values are public identifiers, not secrets.
  "vars": {
    // Support watch alerts (src/supportwatch.js) go here only.
    "ALERT_TO": "eric@positivetribes.org",
    // Client emails (src/clientmail.js): a blind copy of every live email goes here while they settle in. Blank it to stop.
    "CLIENT_MAIL_BCC": "eric@positivetribes.org",
    "ACCESS_TEAM_DOMAIN": "positivetribes.cloudflareaccess.com",
    "ACCESS_AUD": "9dc04910d410b1e8c6739841b429ce28e81e7a9796758c75bbac93bf10bd634a",
    // The daily command center sync routine's Access service token (its client ID, a public identifier). Only this
    // token may call the command center's two sync routes. Salesforce credentials are secrets (wrangler secret put).
    "SYNC_SERVICE_TOKENS": "1832d7e5e79b6740c6a00a00ee1facd6.access",
    // Client repos' CI tokens for POST /api/sync/requirements, "<client id>.access=<client slug>" (src/requirements.js).
    "REQUIREMENTS_SYNC_TOKENS": "d9c2ea9225000b8d0b964740c8dde2a9.access=uep",
    // Next steps sync with Salesforce Tasks: new Tasks are owned by this Salesforce user (Eric), and only this host
    // writes them, so pull request previews (own database, same Salesforce) never touch real Tasks.
    "SF_TASK_OWNER_ID": "005Hu00000QcVdBIAV",
    "SF_TASK_SYNC_HOST": "hub.positivetribes.org",
    // Public status pages (the tribe-status Worker); the hub shows each client's checks on their home page.
    "STATUS_URL": "https://status.positivetribes.org",
    // Patch (the AI triage helper) runs only while this is hub.positivetribes.org (blank it to switch Patch off) and the
    // ANTHROPIC_API_KEY secret is set (wrangler secret put). Previews share this value; what keeps them off the API is
    // that crons run only on the deployed Worker and a manual run must come in on hub.positivetribes.org itself.
    "PATCH_HOST": "hub.positivetribes.org",
    // Weekly website digest (src/web.js): runs only on this host. Leads and gifts come from Salesforce (secrets above);
    // visits from Cloudflare Web Analytics: the account id and the site's tag are public identifiers, the token is the
    // CF_ANALYTICS_TOKEN secret (Account Analytics: Read only; wrangler secret put).
    "WEB_HOST": "hub.positivetribes.org",
    "CF_ACCOUNT_ID": "d7e67bd9fff1850969da60348408f3f0",
    "CF_WEB_SITE_TAG": "4b2879219eb7447ca537e8b8c0175ae9"
  },
  // Patch's morning check: 12:00 UTC, 8am Eastern (7am in winter). The website digest: Mondays 14:00 UTC.
  // "30 * * * *": the support watch (src/supportwatch.js); it acts only Mon-Fri 8am-6pm Mountain.
  "triggers": { "crons": ["0 12 * * *", "0 14 * * MON", "30 * * * *"] },
  // Support watch emails go only to Eric; the destination must be verified in Email Routing.
  // CLIENT_MAIL: client emails (src/clientmail.js), used only for clients whose email_mode is 'live'. It may send to any
  // address once positivetribes.org is onboarded in Email Service > Email Sending (Workers Paid), and only from hello@.
  // The code only ever sends to a users row of that client.
  "send_email": [
    { "name": "ALERT_MAIL", "destination_address": "eric@positivetribes.org" },
    { "name": "CLIENT_MAIL", "allowed_sender_addresses": ["hello@positivetribes.org"] }
  ],
  // Prospect PoCs (src/pocusage.js): each PoC Worker's `Usage` RPC entrypoint, for Today's "PoC use" line.
  // STATUS: tribe-status's `Incidents` RPC entrypoint (closed outages and check coverage) for the support watch.
  "services": [{ "binding": "POC_WFA", "service": "wfa-commissions", "entrypoint": "Usage" }, { "binding": "STATUS", "service": "tribe-status", "entrypoint": "Incidents" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "hub-db", "database_id": "bfa66ad3-605c-4b6c-923e-2329f17e89bf", "migrations_dir": "migrations" },
    // The command center's own notes, next steps, synced activity and sync history (tables created at runtime).
    { "binding": "ADMIN_DB", "database_name": "positivetribes-admin-db", "database_id": "c74ab999-3171-432b-9234-da16795e7e50" }
  ],
  // Pull request builds run `wrangler preview`; previews use their own database so test edits never touch real data.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "hub-preview-db", "database_id": "5ccf4e7c-c052-4064-b0bd-f94fdc8b6c86", "migrations_dir": "migrations" },
      { "binding": "ADMIN_DB", "database_name": "positivetribes-admin-preview-db", "database_id": "f6140db8-4e66-4952-bacc-9a71c293a8f9" }
    ]
  }
}
