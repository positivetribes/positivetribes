{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dogs",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "dogs.positivetribes.org", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dogs-db"
    }
  ]
}
