{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uep-backlog",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uep-backlog-db",
      "database_id": "9bde984c-fd0c-4705-8d41-61624aec89ff"
    }
  ],
  // Pull request builds run `wrangler preview`, which requires this block.
  // Previews use their own database so test edits never touch real data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "uep-backlog-preview-db",
        "database_id": "5a1c43e9-e4c3-4bec-8751-1d586ba0c9ec"
      }
    ]
  }
}
