{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soberafe-backlog",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  // Sober AF moved to Tribe Hub: the page forwards there and the API refuses changes.
  "vars": { "MOVED_TO": "hub.positivetribes.org" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soberafe-backlog-db",
      "database_id": "6f221a25-b48a-4121-8b24-16f72f83f802"
    }
  ],
  // Pull request builds run `wrangler preview`, which requires this block.
  // Previews use their own database so test edits never touch real data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "soberafe-backlog-preview-db",
        "database_id": "9e9b6403-0523-4f15-864e-e9777fd864dc"
      }
    ]
  }
}
